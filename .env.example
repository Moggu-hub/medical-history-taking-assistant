# Server Port
PORT=3000

# Database Engine: 'sqlite' (zero-install Phase 1) or 'postgres' (Phase 1 Docker VPS / Phase 2 Hospital On-Premise)
DB_CLIENT=sqlite

# SQLite File Path (used when DB_CLIENT=sqlite)
SQLITE_PATH=./data/er_assistant.sqlite

# PostgreSQL Connection String (used when DB_CLIENT=postgres)
# Example Docker Compose / On-Premise:
# DATABASE_URL=postgres://er_admin:change_strong_password@postgres:5432/ratchaburi_er
DATABASE_URL=

# Zero-Disruption Auto-TTL Retention for COMPLETED cases only (waiting / in_progress are NEVER purged)
COMPLETED_TTL_HOURS=12
CLEANUP_MODE=archive
CLEANUP_INTERVAL_MIN=30

# Centralized 1-Click AI Consultant Security & Optional Env Fallback
# Set a strong random string in production to encrypt the Admin-saved AI API key at rest (AES-256-GCM)
AI_KEY_SECRET=
# Optional: pre-seed AI API key from environment (can still be overridden by Admin in UI)
GEMINI_API_KEY=
